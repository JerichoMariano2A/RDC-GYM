# Copy to .env and set values
PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=adminpass
DB_NAME=rdc_gym
JWT_SECRET=change_this_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpass
# Shared secret for the ESP32 door unit (must match esp32/RDC_Door/config.h ESP_SECRET)
ESP_SECRET=rdc_esp_secret
# Legacy fallback for ESP_SECRET (kept for compatibility)
BIOMETRIC_SECRET=rdc_biometric_secret
