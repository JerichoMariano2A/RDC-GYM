# Copy to .env and set values
PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rdc_gym
JWT_SECRET=change_this_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpass

# Fingerprint sensor (AS608/R307 via ESP32's USB-Serial bridge)
# COM5 is the ESP32's CP2102 USB-to-UART bridge
FINGERPRINT_PORT=COM5
